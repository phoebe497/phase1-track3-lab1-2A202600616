# LLM API Configuration
# Paste your primary API Key here (or comma-separated list of keys)
LLM_API_KEY=your-api-key-here

# (Optional) Paste your secondary API Key here for rotation when hitting rate limits (429)
LLM_API_KEY_SECONDARY=your-secondary-api-key-here

# Base URL for LLM API (default is LiteLLM endpoint, can be overridden for Groq, OpenAI, etc.)
LLM_BASE_URL=https://api.groq.com/openai/v1

# The LLM model to query
LLM_MODEL=llama-3.3-70b-versatile

# LLM Mode: 'llm' to run on the real LLM API, 'mock' to run the fast deterministic simulator
LLM_MODE=mock
